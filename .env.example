# --- Database ---
# Local dev (default, no setup required):
# DATABASE_URL=sqlite+aiosqlite:///./webdna.db
#
# Supabase (production): use the "Transaction pooler" connection string
# (Project Settings > Database > Connection string > Transaction pooler, port 6543).
# Rewrite it to the asyncpg dialect: postgresql -> postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct (non-pooled) connection, used only for Alembic migrations.
# Use the "Session pooler" (port 5432) or the direct DB host from the same page.
DIRECT_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Mocked Bright Data Collectors for the MVP (or placeholders for CLI configuration if needed)
BRIGHT_DATA_PRODUCTS_COLLECTOR_ID=c_products_123
BRIGHT_DATA_CAREERS_COLLECTOR_ID=c_careers_123
BRIGHT_DATA_NEWS_COLLECTOR_ID=c_news_123
BRIGHT_DATA_POSITIONING_COLLECTOR_ID=c_positioning_123

# Bright Data SERP/Web Unlocker API (used by the agent's search tool).
# Get BRIGHT_DATA_API_KEY from Bright Data dashboard > Account Settings > API Tokens.
# BRIGHT_DATA_SERP_ZONE is the name of a SERP API / Web Unlocker zone in your account.
# Leave unset to have search calls fail gracefully (the agent falls back to mocked evidence).
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1

# LLM Config (Using Gemma as requested)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it:free

DEMO_MODE=false
# URL of the deployed frontend, used for CORS
FRONTEND_URL=http://localhost:3000
